# ML Service Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Model Configuration
# Options: original, unbiased, multilingual
MODEL_NAME=original
CACHE_DIR=/root/.cache/huggingface
BATCH_SIZE=8
MAX_LENGTH=512

# API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Thresholds
TOXICITY_THRESHOLD=0.7
SEVERE_TOXICITY_THRESHOLD=0.8
OBSCENE_THRESHOLD=0.7
THREAT_THRESHOLD=0.75
INSULT_THRESHOLD=0.7
IDENTITY_ATTACK_THRESHOLD=0.7

# Performance
WORKERS=4
TIMEOUT=300
