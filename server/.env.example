# Server Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://safemind:safemind_dev_password@localhost:5432/safemind_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@safemind.app
SENDGRID_TEMPLATE_ID_ALERT=your_alert_template_id

# Alert Thresholds
TOXICITY_THRESHOLD=0.7
SEVERE_TOXICITY_THRESHOLD=0.8
THREAT_THRESHOLD=0.75
IDENTITY_ATTACK_THRESHOLD=0.7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
